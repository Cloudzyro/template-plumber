---
import Base from "../layouts/Base.astro";
import PipeRun from "../components/PipeRun.astro";
import Elbow from "../components/Elbow.astro";
import Icon from "../components/Icon.astro";
import PriceTable from "../components/PriceTable.astro";
import Review from "../components/Review.astro";
import { site, services, pricing, areas, areaNote, reviews, promises, formatPrice } from "../data/site";

const promiseIcons = ["phone", "check", "shield"] as const;
---

<Base>
  <section class="hero dark">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1 class="display">Leaks, clogs and cold showers fixed across Marlow County</h1>
        <p class="lede">
          A family plumbing company since {site.since}. Licensed, insured, and a fixed price agreed before any work
          starts.
        </p>
        <div class="phone-block">
          <p>Water where it shouldn't be? Call now, day or night</p>
          <a href={site.phoneHref} class="big-phone">{site.phone}</a>
        </div>
        <div class="actions">
          <a class="btn btn-copper" href={site.phoneHref}><Icon name="phone" />Call now</a>
          <a class="btn btn-line" href="/quote">Get a quote</a>
        </div>
      </div>
      <div class="hero-visual">
        <PipeRun />
      </div>
    </div>
    <ul class="wrap promises">
      {
        promises.map((p, i) => (
          <li>
            <Icon name={promiseIcons[i]} />
            <div>
              <h2>{p.title}</h2>
              <p>{p.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <Elbow dark />
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display">What we fix</h2>
        <a class="text-link" href="/services">All services and what's included</a>
      </div>
      <ul class="service-list">
        {
          services.map((s) => (
            <li>
              <h3>
                <a href={`/services#${s.slug}`}>{s.name}</a>
              </h3>
              <p class="summary">{s.summary}</p>
              <p class="from">
                <span>From</span> {formatPrice(s.from)}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Elbow />

  <section class="section">
    <div class="wrap pricing-grid">
      <div>
        <h2 class="display">Prices, published</h2>
        <p class="lede">You'll know the price before we start. These are the rates we charge everyone.</p>
        <dl class="rates">
          <div>
            <dt>{pricing.callOut.label}</dt>
            <dd>{formatPrice(pricing.callOut.price)}</dd>
          </div>
          <div>
            <dt>{pricing.hourly.label}</dt>
            <dd>{formatPrice(pricing.hourly.price)}</dd>
          </div>
          <div>
            <dt>{pricing.afterHours.label}</dt>
            <dd class="small">1.5x labor</dd>
          </div>
        </dl>
        <a class="text-link" href="/pricing">Full pricing guide</a>
      </div>
      <PriceTable limit={5} />
    </div>
  </section>

  <Elbow />

  <section class="section">
    <div class="wrap areas-grid">
      <div>
        <h2 class="display">Where we work</h2>
        <p class="lede">{areaNote}</p>
        <a class="text-link" href="/areas">Towns and ZIP codes</a>
      </div>
      <ul class="towns">
        {
          areas.map((a) => (
            <li>
              <Icon name="pin" size={16} />
              {a.town}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Elbow />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display">What customers say</h2>
        <a class="text-link" href="/reviews">More reviews</a>
      </div>
      <div class="reviews">
        {reviews.slice(0, 3).map((r) => <Review review={r} />)}
      </div>
      <p class="sample note">Sample reviews written for this template. Replace them with your own.</p>
    </div>
  </section>

  <section class="cta dark">
    <div class="wrap cta-inner">
      <div>
        <h2 class="display">Not urgent? Send us the details</h2>
        <p class="lede">Tell us what's wrong and where. We'll call back with a price within two working hours.</p>
      </div>
      <div class="actions">
        <a class="btn btn-copper" href="/quote">Get a quote</a>
        <a class="btn btn-line" href={site.phoneHref}>{site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--navy-1);
    padding-top: clamp(48px, 6vw, 72px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  h1 {
    font-size: clamp(42px, 5.6vw, 68px);
    max-width: 14ch;
  }
  .hero .lede {
    margin-top: 20px;
    max-width: 32rem;
  }
  .phone-block {
    margin-top: 32px;
    padding-left: 20px;
    border-left: 4px solid var(--copper);
  }
  .phone-block p {
    color: var(--on-navy-2);
    font-size: 16px;
  }
  .big-phone {
    font: 600 clamp(40px, 4.6vw, 56px) / 1.05 var(--font-display);
    color: var(--on-navy);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .big-phone:hover {
    color: var(--copper);
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  .promises {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 64px;
    padding-block: 32px 40px;
    border-top: 1px solid var(--line-navy);
  }
  .promises li {
    display: flex;
    gap: 12px;
    align-items: start;
  }
  .promises svg {
    color: var(--copper);
    margin-top: 4px;
  }
  .promises h2 {
    font: 500 17px/1.4 var(--font-body);
  }
  .promises p {
    color: var(--on-navy-2);
    font-size: 15px;
  }

  .service-list {
    border-top: 1px solid var(--line);
  }
  .service-list li {
    display: grid;
    grid-template-columns: 260px 1fr 120px;
    gap: 32px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .service-list a {
    text-decoration: none;
    transition: color 150ms var(--ease);
  }
  .service-list a:hover {
    color: var(--copper-ink);
  }
  .summary {
    color: var(--ink-2);
    max-width: 40rem;
  }
  .from {
    text-align: right;
    font-weight: 500;
    font-size: 19px;
  }
  .from span {
    font-weight: 400;
    font-size: 15px;
    color: var(--ink-3);
  }

  .pricing-grid,
  .areas-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .pricing-grid .lede,
  .areas-grid .lede {
    margin-top: 16px;
  }
  .rates {
    margin-block: 32px;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .rates div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }
  .rates dt {
    color: var(--ink-2);
    font-size: 16px;
  }
  .rates dd {
    font: 600 28px/1 var(--font-display);
    white-space: nowrap;
  }
  .rates dd.small {
    font-size: 22px;
  }
  .areas-grid .text-link {
    display: inline-block;
    margin-top: 24px;
  }
  .towns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px 24px;
    padding: 24px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .towns li {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .towns svg {
    color: var(--ink-3);
  }

  .reviews {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 16px;
  }
  .reviews :global(.review:first-child blockquote) {
    font-size: 21px;
  }
  .note {
    margin-top: 16px;
  }

  .cta {
    background: var(--navy-0);
    padding-block: 64px;
  }
  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .cta .lede {
    margin-top: 12px;
  }
  .cta .actions {
    margin-top: 0;
  }

  @media (max-width: 960px) {
    .hero-grid,
    .pricing-grid,
    .areas-grid {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      max-width: 560px;
    }
    .reviews {
      grid-template-columns: 1fr;
    }
    .service-list li {
      grid-template-columns: 1fr auto;
      gap: 8px 24px;
    }
    .summary {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  @media (max-width: 720px) {
    .promises {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 48px;
    }
    .towns {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
