---
// Fixed at the bottom on phones so the call button is always under a thumb.
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<div class="callbar" role="region" aria-label="Call or get a quote">
  <a class="btn btn-copper call" href={site.phoneHref}><Icon name="phone" />Call {site.phone}</a>
  <a class="btn btn-line quote" href="/quote">Quote</a>
</div>

<style>
  .callbar {
    display: none;
  }
  @media (max-width: 860px) {
    .callbar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      display: flex;
      gap: 8px;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: var(--navy-0);
      border-top: 1px solid var(--line-navy);
    }
    .call {
      flex: 1;
      min-height: 52px;
      font-weight: 600;
    }
    .quote {
      min-height: 52px;
      background: transparent;
      color: var(--on-navy);
      border-color: rgba(238, 241, 245, 0.24);
    }
    .quote:hover {
      background: var(--navy-2);
    }
  }
</style>
