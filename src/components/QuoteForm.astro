---
// Sends to PUBLIC_FORM_ENDPOINT (Formspree, Basin, a Supabase function or similar).
// With no endpoint set, sending opens the visitor's email app instead.
// A service can be preselected with ?job=<service slug> in the address.
import { site, services } from "../data/site";

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
const subject = `Quote request for ${site.name}`;
---

<form
  class="quote-form"
  method="post"
  action={endpoint || `mailto:${site.email}`}
  data-endpoint={endpoint}
  data-email={site.email}
  data-subject={subject}
>
  {
    !endpoint && (
      <p class="note" role="note">
        This form isn't connected yet, so sending it opens your email app. You can also write to{" "}
        <a href={`mailto:${site.email}?subject=${encodeURIComponent(subject)}`}>{site.email}</a>.
      </p>
    )
  }
  <input type="hidden" name="_subject" value={subject} />
  <div class="row">
    <label class="field">
      <span>Your name</span>
      <input name="name" autocomplete="name" required />
    </label>
    <label class="field">
      <span>Phone</span>
      <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
    </label>
  </div>
  <label class="field">
    <span>Email <span class="hint">(optional, for a written quote)</span></span>
    <input name="email" type="email" autocomplete="email" />
  </label>
  <label class="field">
    <span>Address of the job</span>
    <input name="address" autocomplete="street-address" required />
  </label>
  <div class="row">
    <label class="field">
      <span>Job type</span>
      <select name="job">
        {services.map((s) => <option value={s.slug}>{s.name}</option>)}
        <option value="other">Something else</option>
      </select>
    </label>
    <label class="field">
      <span>How soon</span>
      <select name="urgency">
        {site.urgency.map((u) => <option>{u}</option>)}
      </select>
    </label>
  </div>
  <p class="urgent" hidden>
    Water running now? Turn off the main shutoff if you can, then call us on{" "}
    <a href={site.phoneHref}>{site.phone}</a>. Phoning is faster than this form.
  </p>
  <label class="field">
    <span>What's going on</span>
    <textarea name="description" rows="5" placeholder="Where it is, what you've noticed, how long it's been happening"></textarea>
  </label>
  <div class="actions">
    <button class="btn btn-ink" type="submit">Send quote request</button>
    <p class="status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("form.quote-form").forEach((form) => {
    const job = form.elements.namedItem("job") as HTMLSelectElement;
    const asked = new URLSearchParams(window.location.search).get("job");
    if (asked && [...job.options].some((o) => o.value === asked)) job.value = asked;

    const urgency = form.elements.namedItem("urgency") as HTMLSelectElement;
    const urgent = form.querySelector<HTMLElement>(".urgent")!;
    const showUrgent = () => (urgent.hidden = urgency.selectedIndex !== 0);
    urgency.addEventListener("change", showUrgent);
    showUrgent();

    const status = form.querySelector<HTMLElement>(".status")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const { endpoint, email, subject } = form.dataset;
      const data = new FormData(form);

      if (!endpoint) {
        const lines = [...data.entries()]
          .filter(([key, value]) => !key.startsWith("_") && String(value).trim())
          .map(([key, value]) => `${key}: ${value}`);
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject ?? "")}&body=${encodeURIComponent(lines.join("\n"))}`;
        status.textContent = "Your email app should open with your details filled in.";
        return;
      }

      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      button.disabled = true;
      status.textContent = "Sending";
      try {
        const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        showUrgent();
        status.textContent = "Thanks. We'll call you back within two working hours.";
      } catch {
        status.textContent = "";
        status.append("Sorry, that didn't send. Please call us or email ");
        const link = Object.assign(document.createElement("a"), { href: `mailto:${email}`, textContent: email });
        status.append(link, ".");
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .quote-form {
    display: grid;
    gap: 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 4vw, 32px);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .note,
  .urgent {
    font-size: 15px;
    color: var(--ink-2);
    background: var(--raised);
    border-radius: var(--radius);
    padding: 12px 16px;
  }
  .urgent {
    color: var(--ink);
    border-left: 4px solid var(--copper);
  }
  .urgent a,
  .note a {
    color: var(--copper-ink);
    font-weight: 500;
  }
  .actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  .status {
    font-size: 15px;
    color: var(--ink-2);
  }
</style>
